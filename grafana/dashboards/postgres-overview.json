        "includeAll": true,
        "allValue": ".+",
        "query": "generator,db-exporter,auth",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "generator",
            "value": "generator"
          },
          {
            "selected": false,
            "text": "db-exporter",
            "value": "db-exporter"
          },
          {
            "selected": false,
            "text": "auth",
            "value": "auth"
          }
        ]
      },
      {
        "name": "level",
        "label": "Рівень логу",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "info,warning,error",
