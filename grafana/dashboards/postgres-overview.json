      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "topk(8, sum by (query) (rate(pg_stat_statements_exec_time_seconds_total[5m])))"
